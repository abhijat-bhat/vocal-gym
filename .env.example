# Vocal Gym server settings. Copy to .env, which is not committed, and fill in what you use.

# The address people reach the app at. Needed behind a proxy, and for Google's redirect.
# PUBLIC_URL=https://vocalgym.example.com

# Sign in with Google: create an OAuth client ("Web application") at https://console.cloud.google.com/apis/credentials
# and add <PUBLIC_URL>/api/auth/google/callback as an authorized redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email codes, over SMTP. For Gmail, make an app password: smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# SMTP_URL=
# MAIL_FROM=Vocal Gym <you@gmail.com>

# With NODE_ENV unset and no mail service, the code is printed on the server's console, so it can be tried locally.
# In production email sign-in is then simply not offered.
# NODE_ENV=production
