lines":6,"full":6,"lead":0,"joined":0,"tail":0,"link":0,"partial":0,"fast4":0,"badChars":0,"sahitya":6},"unknown":"","compared":[{"source":"Carnatic Music Notations","url":"https://carnaticnotations.blogspot.com/2022/01/geetham-govindahare-shankarabharanam.html","score":0.947,"fit":1,"raga":1,"octave":0.989,"whole":0.856,"agree":0.795,"lines":6,"used":true},{"source":"Geetham notes","pages":[33,34],"score":0.947,"fit":1,"raga":1,"octave":0.977,"whole":0.918,"agree":0.742,"lines":11}],"meaning":{"source":{"name":"Geetham notes","author":"Gurukulam & SF","url":"","pages":[33]},"parts":[{"text":["O Govinda!! You who are endless, O Vishnu, who killed the Raakshasa Madhu, who wear the tulasi mala, who hold Garuda on your flag, who killed the demon Muku, who hold SriDevi in your heart. O benevolent king of Raghuvamsha, brother of Balarama, O Rama, victory to you, who are dearest to Sita, who are crowned as King of Ayodhya: shower your blessings on me."]}],"words":[{"lyric":["gOvindAchyuta harE madhusUdhana","vanamAla garuDha dhvaja mukunda","Sreedhara Sree raghupatE sankarshaNa","sundarAnga jayajaya SreerAma","sItAbhirAmA mAM pAhi paTTAbhirAma"],"text":["O Govinda (gOvinda)!! You who are endless (achyuta), O Vishnu (harae), who killed the Raakshasa Madhu (madhusoodhana), who wear the tulasi garland (vanamaala), who hold Garuda on your flag (garuDha dhvaja), who killed the demon Muku (mukunda), who hold SriDevi (Goddess Lakshmi) in your heart (Sreedhara). O benevolent king of Raghuvamsha (Sree raghupatae), brother of Balarama (sankarshaNa), O beautiful Rama, victory to you (sundaraanga jayajaya), who are dearest to Sita (seetaabhiraama), who are crowned as King of Ayodhya (paTTaabhiraama): shower your blessings (pahi) on me (maam)."]}]}}
