":[[0,"taM"],[9,"sa"]]},{"cells":["P , P ,","D P","P D P ,"],"syl":[[0,"nA"],[4,"ga"],[5,"bhU"],[7,"sha"],[8,"NA"]]},{"cells":["M G , R","G ,","D P M G"],"syl":[[0,"li"],[1,"rA"],[3,"ga"],[4,"rA"],[8,"ji"],[9,"ta"]]},{"cells":["D , D ,","N D","D N P ,"],"syl":[[0,"Su"],[4,"dda"]]},{"cells":["P , D N","P ,","D P M G"],"syl":[[0,"spa"],[2,"Ti"],[3,"ka"],[4,"dE"],[9,"ha"]]},{"cells":["P , D S'","N ,","D N D P"],"syl":[[0,"gA"],[2,"na"],[3,"sa"],[4,"mu"],[9,"dra"]]},{"cells":["D , N D","P ,","D P M G"],"syl":[[0,"rA"],[3,"ga"],[4,"vl"],[9,"chi"]]},{"cells":["P D , S'","N S'","D N P D"],"syl":[[0,"vi"],[1,"rA"],[5,"ja"],[6,"mA"],[9,"na"]]},{"cells":["P D N ,","D N","D P M G"],"syl":[[0,"kA"],[2,"lA"],[9,"Di"]]},{"cells":["P D R' S'",", S'","N D P D"],"syl":[[0,"nau"],[8,"ka"]]},{"cells":["P S' N D","N P","D P M G"],"syl":[[0,"ma"],[8,"dhyE"]]},{"cells":["G P P D","D S'","S' N N D"],"syl":[[0,"swa"],[1,"ra"],[2,"sO"],[4,"pA"],[9,"na"]]},{"cells":["P D S' ,","P D",", P M G"],"syl":[[0,"Sru"],[1,"ti"],[2,"vA"],[4,"tA"],[8,"ya"],[9,"na"]]},{"cells":["S' N S' D","N P","D P M G"],"syl":[[0,"nA"],[2,"da"],[4,"pra"],[6,"sA"],[9,"da"]]},{"cells":["D D N P","D P","M G R S"],"syl":[[0,"vi"],[1,"la"],[2,"si"],[3,"ta"],[4,"Sam"],[6,"bhO"]]},{"cells":["R G M R","G R","S N. D. ,"]},{"cells":["S R G M","G R","G R R ,"]},{"cells":["D. G , R","S R","S N. D. ,"],"syl":[[0,"mu"],[1,"dam"],[3,"dE"],[5,"hi"],[6,"mE"]]},{"cells":["S R G R","R G","S R S ,"],"syl":[[0,"gu"],[1,"ru"],[2,"mU"],[8,"rtE"]]}]}],"stats":{"rows":31,"lines":31,"sahitya":29,"full":31,"lead":0,"joined":0,"tail":0,"link":0,"partial":0,"fast4":0,"badChars":0},"unknown":"","meaning":{"source":{"name":"Geetham notes","author":"Gurukulam & SF","url":"","pages":[75]},"parts":[{"text":["O Ruler Nageswara, you are the protector of vandis and budhas. We praise your feet, which fulfil our wishes. I sing your greatness with the transformation of music. You have the moon decorating your head. You glitter with tone, as you wear serpents as ornaments. You have a crystal body and have music as your ocean. You are splendid, having raga as waves. If we compare life to a boat, you have swaras as the ladder and sruti as the curtain; you shine by building the above qualities of sound as a periphery. O well-wisher, give us happiness."]}],"words":[{"lyric":["pAlaya nAgESvara vandibudhAvali","pArijAta namAmi tava charaNaM","vAnChati dhIrapi mE gAna vaikharyA","mahimAnantavagAtuM kRshNa taTavAsin","kadaLI vana mandira jayarE","chandrakaLAvataMsa nAgabhUsha NAli rAga rAjita","Sudda spaTika dEha gAna samudra","rAga vIchiviraaja mAna kAlADi nauka madhyE","svara sOpAna sRtivAtayana nAda prAsAda","vilasita SaMbhO mudaMdEhi mE gurumUrtE"],"text":["O Ruler (pAlaya) Nageswara (nAgESvara), you are the protector (pArijAta) of vandis and budhas (vandibudhAvali). We praise (namAmi) your (tava) feet (charaNaM), which fulfil (dhIrapi) our wishes (vAnChati). I sing (gAtum) your (tava) greatness (mahimAnam) with the transformation (vaikharyA) of music (gAna). You have the moon (chandrakaLA) decorating your head (avataMsa). You glitter (rAjita) with tone (rAga), as you wear serpents (nAga) as ornaments (abhUsha). You have a pure crystal (Sudda spaTika) body (dEha) and have music (gAna) as your ocean (samudra). You are splendid, having raga as waves (vIchi). If we compare life to a boat, you have swaras as the ladder (sOpAna) and sruti as the curtain (vAtayana); you shine (vilasita) by building the above qualities of sound (nAda) as a periphery (prAsAda). O well-wisher (SaMbhO), give (dEhi) us happiness (mudaM)."]}]}}
