rE rE","syl":[[0,"ka"],[1,"ri"],[2,"gi"],[3,"ri"],[4,"ni"],[5,","],[6,"va"],[7,","],[8,","],[8,"su"],[10,"rE"]]}]}],"stats":{"rows":12,"lines":5,"full":5,"lead":0,"joined":0,"tail":0,"link":0,"partial":0,"fast4":0,"badChars":0,"sahitya":5},"unknown":"","compared":[{"source":"Carnatic Music Notations","url":"https://carnaticnotations.blogspot.com/2020/12/geetham-janakasutha-saveri-roopakam.html","score":0.91,"fit":1,"raga":1,"octave":1,"whole":0.748,"agree":0.651,"lines":5,"used":true},{"source":"Geetham notes","pages":[22,23],"score":0.909,"fit":1,"raga":1,"octave":0.988,"whole":0.766,"agree":0.635,"lines":9}],"meaning":{"source":{"name":"Geetham notes","author":"Gurukulam & SF","url":"","pages":[22]},"parts":[{"text":["Oh Rama, you are decorated by the kumkum that is Sita, the daughter of Janaka. You are the one who killed emperor Bali. You have Garuda as your vahana. You saved Gajendra and granted him boons. You are the lord of the auspicious Lakshmi. You reside in Karigiri."]}],"words":[{"lyric":["Janaka suta kucha kumkuma","pankita lanchanu rE rE","BaliharurE khaga vAhana","kAncheepuri nilayA","kari rakshaka bhuja vikrama","kAmitha phaladayaka","karivaradA kalyaNA","perundEvi manOharurE","karigiri nivAsurE"],"text":["Oh Rama, you are decorated by the kumkum (“kuca kumkuma”) that is Sita, the daughter of Janaka (“Janaka sutha”). You are the one who killed emperor Bali (“Baliharure”). You have Garuda as your vahana (“khaga vahana”). You saved Gajendra and granted him boons (“karivarada”). You are the lord (“manoharure”) of the auspicious (“kalyana”) Lakshmi (“Perundevi”). You reside (“nivasure”) in Karigiri."]}]}}
